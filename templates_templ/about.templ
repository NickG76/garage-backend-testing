package templates

import "hcs-full/models"

templ AboutPage(data models.PageData) {
	@headerComponent(data)
	<main>
		<!-- Hero Section -->
		<section class="about-hero text-white py-32" style="background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('http://static.photos/automotive/1200x630/2'); background-size: cover; background-position: center;">
			<div class="container mx-auto px-4 text-center">
				<h1 class="text-4xl md:text-5xl font-bold mb-6" data-aos="fade-up">About Hartlepool Car Services</h1>
				<p class="text-xl mb-8 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
					Your trusted partner for premium automotive care in Hartlepool
				</p>
			</div>
		</section>
		<!-- Our Story -->
		<section class="py-16 bg-gray-50 dark:bg-gray-900">
			<div class="container mx-auto px-4">
				<div class="flex flex-col lg:flex-row items-center">
					<div class="lg:w-1/2 mb-8 lg:mb-0 lg:pr-8" data-aos="fade-right">
						<img src="http://static.photos/automotive/640x360/20" alt="Our Garage" class="rounded-lg shadow-md w-full"/>
					</div>
					<div class="lg:w-1/2" data-aos="fade-left">
						<h2 class="text-3xl font-bold mb-6">Our Story</h2>
						<p class="text-gray-600 dark:text-gray-400 mb-6">
							Founded in 2010, Hartlepool Car Services began as a small garage with a big vision - to provide exceptional automotive services with honesty and integrity. What started as a two-person operation has grown into Hartlepool's most trusted car service center.
						</p>
						<p class="text-gray-600 dark:text-gray-400 mb-6">
							Over the years, we've invested in state-of-the-art equipment and continuous training for our technicians, ensuring we can handle everything from routine maintenance to complex diagnostics and performance enhancements.
						</p>
						<p class="text-gray-600 dark:text-gray-400 mb-8">
							Our commitment to quality and customer satisfaction has earned us numerous industry awards and, more importantly, thousands of loyal customers who trust us with their vehicles.
						</p>
					</div>
				</div>
			</div>
		</section>
		<!-- Our Values -->
		<section class="py-16 bg-white dark:bg-black">
			<div class="container mx-auto px-4">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold mb-4" data-aos="fade-up">Our Core Values</h2>
					<div class="w-20 h-1 bg-blue-600 mx-auto mb-6" data-aos="fade-up" data-aos-delay="100"></div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg text-center" data-aos="fade-up">
						<div class="text-blue-600 mb-4">
							<i data-feather="award" class="w-12 h-12 mx-auto"></i>
						</div>
						<h3 class="text-xl font-bold mb-3">Quality</h3>
						<p class="text-gray-600 dark:text-gray-400">
							We never compromise on quality. Every job is completed to the highest standards using premium parts and materials.
						</p>
					</div>
					<div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg text-center" data-aos="fade-up" data-aos-delay="100">
						<div class="text-blue-600 mb-4">
							<i data-feather="shield" class="w-12 h-12 mx-auto"></i>
						</div>
						<h3 class="text-xl font-bold mb-3">Trust</h3>
						<p class="text-gray-600 dark:text-gray-400">
							Honest pricing, transparent communication, and reliable service have built our reputation as Hartlepool's most trusted garage.
						</p>
					</div>
					<div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-lg text-center" data-aos="fade-up" data-aos-delay="200">
						<div class="text-blue-600 mb-4">
							<i data-feather="users" class="w-12 h-12 mx-auto"></i>
						</div>
						<h3 class="text-xl font-bold mb-3">Service</h3>
						<p class="text-gray-600 dark:text-gray-400">
							Customer satisfaction is our priority. We go above and beyond to ensure every customer leaves happy with our service.
						</p>
					</div>
				</div>
			</div>
		</section>
		<!-- Team Section -->
		<section class="py-16 bg-gray-50 dark:bg-gray-900">
			<div class="container mx-auto px-4">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold mb-4" data-aos="fade-up">Meet Our Expert Team</h2>
					<div class="w-20 h-1 bg-blue-600 mx-auto mb-6" data-aos="fade-up" data-aos-delay="100"></div>
					<p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="200">
						Our certified technicians have decades of combined experience working with all major vehicle brands and models.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md" data-aos="fade-up">
						<img src="http://static.photos/people/640x640/1" alt="Team Member" class="w-full h-64 object-cover"/>
						<div class="p-6">
							<h3 class="text-xl font-bold mb-2">Mike Johnson</h3>
							<p class="text-blue-600 mb-3">Master Technician</p>
							<p class="text-gray-600 dark:text-gray-400">
								With over 20 years of experience, Mike specializes in engine diagnostics and performance tuning.
							</p>
						</div>
					</div>
					<div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md" data-aos="fade-up" data-aos-delay="100">
						<img src="http://static.photos/people/640x640/2" alt="Team Member" class="w-full h-64 object-cover"/>
						<div class="p-6">
							<h3 class="text-xl font-bold mb-2">Sarah Williams</h3>
							<p class="text-blue-600 mb-3">Service Manager</p>
							<p class="text-gray-600 dark:text-gray-400">
								Sarah ensures every customer receives exceptional service and maintains our high quality standards.
							</p>
						</div>
					</div>
					<div class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md" data-aos="fade-up" data-aos-delay="200">
						<img src="http://static.photos/people/640x640/3" alt="Team Member" class="w-full h-64 object-cover"/>
						<div class="p-6">
							<h3 class="text-xl font-bold mb-2">Tom Roberts</h3>
							<p class="text-blue-600 mb-3">Senior Technician</p>
							<p class="text-gray-600 dark:text-gray-400">
								Tom's expertise in electrical systems and modern vehicle technology keeps us at the cutting edge.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- Call to Action -->
		<section class="py-16 bg-blue-600 text-white">
			<div class="container mx-auto px-4 text-center">
				<h2 class="text-3xl font-bold mb-4" data-aos="fade-up">Ready to Experience the Difference?</h2>
				<p class="text-xl mb-8 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
					Join thousands of satisfied customers who trust Hartlepool Car Services with their vehicles.
				</p>
				<div class="flex flex-col sm:flex-row justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
					<a
						href="/contact"
						hx-get="/contact"
						hx-target="body"
						hx-swap="outerHTML"
						hx-push-url="true"
						class="bg-white hover:bg-gray-100 text-blue-600 font-bold py-3 px-6 rounded transition duration-300"
					>
						Contact Us Today
					</a>
					<a
						href="/services"
						hx-get="/services"
						hx-target="body"
						hx-swap="outerHTML"
						hx-push-url="true"
						class="bg-transparent hover:bg-white hover:text-blue-600 text-white font-bold py-3 px-6 border-2 border-white rounded transition duration-300"
					>
						View Our Services
					</a>
				</div>
			</div>
		</section>
	</main>
	@footerComponent()
}